// font
$font-size = theme-config("font.font_size", "16px")
$letter-spacing = theme-config("font.letter_spacing", "0.02em")
$font-family = theme-config("font.font_family", "var(--font-family-sans-serif)")
$code-font-size = theme-config("font.code_font_size", "85%")

// ── Style preset ─────────────────────────────────────────────────────────────
$fluid-style = theme-config-origin("fluid_style", "flat")

// ── Color palettes ────────────────────────────────────────────────────────────
// Each palette file defines a Stylus hash with all default token values.
// To add a new style, create color-palette-<name>.styl and add it below.
@import "color-palette-flat"
@import "color-palette-classic"

// Select the active palette by style name; fall back to flat for unknowns.
$palette = $fluid-style == "classic" ? $palette-classic : $palette-flat

// ── Derive $* variables (user theme-config always wins) ───────────────────────
// theme-config reads _config.yml; if the user left it blank the second
// arg is the palette default, so switching styles changes the default seamlessly.

$body-bg-color       = color-config("color.body_bg_color",       $palette[body-bg])
$body-bg-color-dark  = color-config("color.body_bg_color_dark",  $palette[body-bg-dark])
$board-bg-color      = color-config("color.board_color",         $palette[board-bg])
$board-bg-color-dark = color-config("color.board_color_dark",    $palette[board-bg-dark])
$text-color          = color-config("color.text_color",          $palette[text])
$text-color-dark     = color-config("color.text_color_dark",     $palette[text-dark])
$sec-text-color      = color-config("color.sec_text_color",      $palette[sec-text])
$sec-text-color-dark = color-config("color.sec_text_color_dark", $palette[sec-text-dark])
$post-text-color     = color-config("color.post_text_color",     $palette[post-text])
$post-text-color-dark= color-config("color.post_text_color_dark",$palette[post-text-dark])
$post-heading-color      = color-config("color.post_heading_color",      $palette[post-heading])
$post-heading-color-dark = color-config("color.post_heading_color_dark", $palette[post-heading-dark])
$post-link-color     = color-config("color.post_link_color",     $palette[post-link])
$post-link-color-dark= color-config("color.post_link_color_dark",$palette[post-link-dark])
$link-hover-color        = color-config("color.link_hover_color",        $palette[link-hover])
$link-hover-color-dark   = color-config("color.link_hover_color_dark",   $palette[link-hover-dark])
$link-hover-bg-color     = color-config("color.link_hover_bg_color",     $palette[link-hover-bg])
$link-hover-bg-color-dark= color-config("color.link_hover_bg_color_dark",$palette[link-hover-bg-dark])
$line-color          = color-config("color.line_color",          $palette[line])
$line-color-dark     = color-config("color.line_color_dark",     $palette[line-dark])
$navbar-bg-color     = color-config("color.navbar_bg_color",     $palette[navbar-bg])
$navbar-bg-color-dark= color-config("color.navbar_bg_color_dark",$palette[navbar-bg-dark])
$navbar-text-color   = color-config("color.navbar_text_color",   $palette[navbar-text])
$navbar-text-color-dark = color-config("color.navbar_text_color_dark", $palette[navbar-text-dark])
$subtitle-color      = color-config("color.subtitle_color",      $palette[subtitle])
$subtitle-color-dark = color-config("color.subtitle_color_dark", $palette[subtitle-dark])
$scrollbar-color     = color-config("color.scrollbar_color",     $palette[scrollbar])
$scrollbar-color-dark= color-config("color.scrollbar_color_dark",$palette[scrollbar-dark])
$scrollbar-hover-color     = color-config("color.scrollbar_hover_color",     $palette[scrollbar-hover])
$scrollbar-hover-color-dark= color-config("color.scrollbar_hover_color_dark",$palette[scrollbar-hover-dark])
$button-bg-color     = color-config("color.button_bg_color",     $palette[button-bg])
$button-bg-color-dark= color-config("color.button_bg_color_dark",$palette[button-bg-dark])
$button-hover-bg-color     = color-config("color.button_hover_bg_color",     $palette[button-hover-bg])
$button-hover-bg-color-dark= color-config("color.button_hover_bg_color_dark",$palette[button-hover-bg-dark])

// code highlight bg: prefer highlightjs config value when explicitly set
$highlight-bg-color = hexo-config("code.highlight.highlightjs.light.backgroundColor") && hexo-config("code.highlight.highlightjs.light.backgroundColor") != "#fff" ? unquote(hexo-config("code.highlight.highlightjs.light.backgroundColor")) : $palette[highlight-bg]
$highlight-bg-color-dark = hexo-config("code.highlight.highlightjs.dark.backgroundColor") && hexo-config("code.highlight.highlightjs.dark.backgroundColor") != "#fff" ? unquote(hexo-config("code.highlight.highlightjs.dark.backgroundColor")) : $palette[highlight-bg-dark]
$inlinecode-bg-color      = $palette[inlinecode-bg]
$inlinecode-bg-color-dark = $palette[inlinecode-bg-dark]

// navbar glass
$navbar-glass-enable = theme-config-origin("navbar.ground_glass.enable", false)
$navbar-glass-px = theme-config-unit("navbar.ground_glass.px", 4, "px")
$navbar-glass-alpha = theme-config-origin("navbar.ground_glass.alpha", 0.8)

// banner
$banner-width-height-ratio = theme-config-origin("banner.width_height_ratio", 0)

// scroll arrow
$scroll-arrow-height-limit = theme-config-origin("scroll_down_arrow.banner_height_limit", 0)

// shadow
$img-shadow = 0 4px 16px 0 rgba(0, 0, 0, 0.12), 0 1px 4px 0 rgba(0, 0, 0, 0.08)
